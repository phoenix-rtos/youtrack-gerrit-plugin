# YouTrack connection settings for plugin development
# Copy this file to .env and fill in your values

# YouTrack instance base URL (required for uploading plugin)
YOUTRACK_BASE_URL=https://youtrack.example.com

# YouTrack permanent token for API access (required for uploading plugin)
# Generate at: YouTrack → Profile → Account Security → Tokens → New Token
YOUTRACK_TOKEN=perm:your-token-here

# Test issue URLs for verifying frontend changes in split view
# Add multiple URLs to test different scenarios (comma-separated or one per line)
# Example format: https://youtrack.example.com/issues/PROJECT?preview=ISSUE-123
YOUTRACK_TEST_URLS=https://youtrack.example.com/issues/PROJECT?preview=ISSUE-123&u=1
